### Local files that stay out of the repository
# Local checkout of the validations package (confidential data and outputs)
/validations
# Local agent instructions
/AGENTS.md
# PDFs are never committed
*.pdf

### Environments and credentials
.env
# .python-version is committed: it pins the interpreter uv uses
.venv
venv/

### Input data of the file-based mode (USE_INFDB: False), not shipped with the repository
/data/buildings/*
!/data/buildings/note.txt
/data/ways/ways_public_2po_4pgr.sql
/data/postcode.csv

# Transformers: keep the processed ones of Bavaria (EPSG 25832), ignore raw downloads and other CRS
/data/transformer_data/fetched_trafos/*
/data/transformer_data/processed_trafos/*
!/data/transformer_data/processed_trafos/2145268_trafos_processed_25832.geojson
# eGon-data HV/MV substations, downloaded from the Open Energy Platform by pylovo-setup
/data/egon_data/

### Output of pylovo runs
# RESULT_DIR: generated grids, figures and analyses
/results/
# Logs: log/log.txt, log/log_<plz>.txt (log/.gitkeep is committed)
/log/*.txt
*.log
# pylovo-api working files: config backups, uploads, job logs, exports
/.pylovo-api/

### Python, build and test caches
__pycache__/
*.py[cod]
# build/ also covers the Sphinx output docs/build/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

### Notebooks
.ipynb_checkpoints/

### Editors and operating systems
.idea/
.DS_Store
