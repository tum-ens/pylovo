# Copy to .env at project root and adjust values

### Database
USE_INFDB = True
DBNAME = "infdb"
DBUSER = "infdb_user"
HOST = "localhost"
PORT = "54321"
PASSWORD = "your_infdb_password"
INFDB_SOURCE_SCHEMA="basedata"
INFDB_OPENDATA_SCHEMA="opendata"
# OSM layers of the InfDB OSM importer (HV/MV substations of the MV stage)
INFDB_OSM_SCHEMA="osm"
TARGET_EPSG = "25832"

### Separate InfDB instance (optional)
# With USE_EXTERNAL_BASEDATA = True the InfDB schemas above are read from the database below,
# while the pylovo schema and its results stay in the database above. Unset values fall back
# to the values above. Works through PgBouncer (no startup options, read-only transactions).
USE_EXTERNAL_BASEDATA = False
# INFDB_DBNAME = "infdb"
# INFDB_USER = "infdb_user"
# INFDB_HOST = "infdb.example.org"
# INFDB_PORT = "5432"
# INFDB_PASSWORD = "your_infdb_password"

### Path Configuration (Optional - for advanced setups with Docker)
# The YAML files are searched in this order: ./config (current working directory),
# $PYLOVO_ROOT/config, $PYLOVO_CONFIG_DIR (else ~/.config/pylovo and ./.pylovo), config/ of the checkout.
# PYLOVO_ROOT="/app"  # Project root directory (config and data fallback)
# PYLOVO_DATA_DIR="/path/to/data"  # Data directory: transformer_data/, municipal_register/, postcode.csv, ways/, buildings/
#   Without it: $PYLOVO_ROOT/data, else ./data (the municipal register also finds the data/ folder of the checkout)
# PYLOVO_CONFIG_DIR="/path/to/config"  # YAML directory, searched after ./config and $PYLOVO_ROOT/config
#   If set, ~/.config/pylovo and ./.pylovo are not searched

### Plotting (optional)
# ACCESS_TOKEN_PLOTLY="your_mapbox_token"  # Mapbox token for the "light" map background of some plotly figures

