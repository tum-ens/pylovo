# Copy to .env at project root and adjust values

### Database
USE_INFDB = True
DBNAME = "infdb"
DBUSER = "infdb_user"
HOST = "localhost"
PORT = "54321"
PASSWORD = "your_infdb_password"
INFDB_SOURCE_SCHEMA="basedata"
INFDB_OPENDATA_SCHEMA="opendata"
TARGET_EPSG = "25832"

### Path Configuration (Optional - for advanced setups with Docker)
# The YAML files are searched in this order: ./config (current working directory),
# $PYLOVO_ROOT/config, $PYLOVO_CONFIG_DIR (else ~/.config/pylovo and ./.pylovo), config/ of the checkout.
# PYLOVO_ROOT="/app"  # Project root directory (config and data fallback)
# PYLOVO_DATA_DIR="/path/to/data"  # Data directory (defaults to $PYLOVO_ROOT/data, else ./data)
# PYLOVO_CONFIG_DIR="/path/to/config"  # Fallback config directory, used only if ./config has no such file

### Validation (for developers)
# GRID_DATA_PATH="/path/to/your/validation/grid_data/<grid_split_dir>"
# NET_NAME="name_of_your_network"

